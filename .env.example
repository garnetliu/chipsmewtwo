# 复制本文件为 `.env`，把占位值换成自己的配置。

# 应用对外访问地址，客户端 Apollo 用它拼 /api/graphql 的请求地址
# 见 graphql/apollo/links/http-link.ts
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# better-auth 用来签发/校验 session 的密钥，随机 32 位字符串
# 生成：openssl rand -base64 32
BETTER_AUTH_SECRET=""

# better-auth 的 base URL，本地开发和 NEXT_PUBLIC_BASE_URL 保持一致
BETTER_AUTH_URL="http://localhost:3000"

# docker-compose 里 postgres 容器的密码，要和 DATABASE_URL 里的密码一致
# 见 docker-compose.yml
POSTGRES_PASSWORD="chipsmewtwo-password"

# PostgreSQL 连接串，要求 PostgreSQL >= 15
# docker-compose 起的库端口映射在 5433
# Prisma 不会自动读这个文件，prisma7.config.ts 里要 import "dotenv/config"
# 连接串参数说明：https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://chipsmewtwo:chipsmewtwo-password@localhost:5433/chipsmewtwo"

# 宝可梦数据从哪儿取
