{
  "name": "chipsmewtwo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "pnpm --filter @pkcw/web dev",
    "build": "pnpm --filter @pkcw/web build",
    "start": "pnpm --filter @pkcw/web start",
    "lint": "eslint --fix",
    "codegen": "pnpm --filter @pkcw/graphql codegen",
    "seed": "pnpm --filter @pkcw/prisma seed",
    "seed:refresh": "pnpm --filter @pkcw/prisma seed:refresh",
    "wiki:refresh": "pnpm --filter @pkcw/prisma wiki:refresh",
    "form-colors:refresh": "pnpm --filter @pkcw/prisma form-colors:refresh",
    "migrate": "pnpm --filter @pkcw/prisma migrate",
    "pkhex:build": "pnpm --filter @pkcw/pkhex-wasm build",
    "pkhex:shell": "pnpm --filter @pkcw/pkhex-wasm shell"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
