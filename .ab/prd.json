      { "id": "VAR-04", "name": "六项努力值总和上限（510）" },
      { "id": "VAR-05", "name": "性格修正系数（一项 ×1.1、一项 ×0.9）" },
      { "id": "VAR-06", "name": "世代筛选（Gen1–Gen9，单选，默认未选中）" }
    ],
    "rules": [
      { "id": "RULE-01", "name": "六项能力值按最新世代公式计算，结果需与游戏一致", "inputVariableId": "VAR-01" },
      { "id": "RULE-02", "name": "个体值超出范围由控件截断，不产生错误提示", "inputVariableId": "VAR-02" },
      { "id": "RULE-03", "name": "单项努力值超出上限由控件截断", "inputVariableId": "VAR-03" },
      { "id": "RULE-04", "name": "六项努力值总和达 510 后任一项不再允许增加", "inputVariableId": "VAR-04" },
      { "id": "RULE-05", "name": "性格对两项能力值施加修正", "inputVariableId": "VAR-05" },
      { "id": "RULE-06", "name": "列表按选中世代过滤，筛选条件保留在 URL 查询参数里", "inputVariableId": "VAR-06" }
